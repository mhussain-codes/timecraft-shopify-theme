{% comment %} Collection page section - product grid with pagination {% endcomment %}

{%- comment %} Paginate products - 12 per page {% endcomment -%}
{% paginate collection.products by 12 %}
<section class="main-collection" id="section-{{ section.id }}">
  <div class="collection__wrapper">

    {%- comment %} Collection heading aur description {% endcomment -%}
    <div class="collection__header">
      <h1 class="collection__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection__description rte">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>

    {%- comment %} Product grid {% endcomment -%}
    {% if collection.products.size > 0 %}
      <div class="collection__grid reveal-stagger-parent">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {%- comment %} Pagination - agar zyada products hain {% endcomment -%}
      {% if paginate.pages > 1 %}
        <nav class="collection__pagination" aria-label="Pagination">
          <ul class="collection__pagination-list">
            {% if paginate.previous %}
              <li>
                <a href="{{ paginate.previous.url }}" class="collection__page-link" aria-label="Previous page">&larr; Prev</a>
              </li>
            {% endif %}

            {% for part in paginate.parts %}
              <li>
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="collection__page-link">{{ part.title }}</a>
                {% else %}
                  <span class="collection__page-link collection__page-link--current" aria-current="page">{{ part.title }}</span>
                {% endif %}
              </li>
            {% endfor %}

            {% if paginate.next %}
              <li>
                <a href="{{ paginate.next.url }}" class="collection__page-link" aria-label="Next page">Next &rarr;</a>
              </li>
            {% endif %}
          </ul>
        </nav>
      {% endif %}

    {% else %}
      <p class="collection__empty-text">No products found in this collection.</p>
    {% endif %}
  </div>
</section>
{% endpaginate %}

<style>
  #section-{{ section.id }} {
    background-color: #FAF8F5;
    padding: 60px 20px;
    font-family: 'Inter', sans-serif;
  }

  #section-{{ section.id }} .collection__wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  #section-{{ section.id }} .collection__header {
    text-align: center;
    margin-bottom: 40px;
  }

  #section-{{ section.id }} .collection__title {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    color: #2D4F3E;
    margin: 0 0 12px;
  }

  #section-{{ section.id }} .collection__description {
    font-size: 15px;
    color: #666;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Product grid - 3 columns desktop, 2 mobile */
  #section-{{ section.id }} .collection__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  /* Product card */
  #section-{{ section.id }} .collection__product-card {
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }

  #section-{{ section.id }} .collection__product-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  #section-{{ section.id }} .collection__product-link {
    text-decoration: none;
    display: block;
  }

  #section-{{ section.id }} .collection__product-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f0ede8;
  }

  #section-{{ section.id }} .collection__product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  #section-{{ section.id }} .collection__product-card:hover .collection__product-image {
    transform: scale(1.05);
  }

  #section-{{ section.id }} .collection__placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #d1cdc7;
    padding: 20%;
  }

  /* Sale badge */
  #section-{{ section.id }} .collection__sale-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #c0392b;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Product info */
  #section-{{ section.id }} .collection__product-info {
    padding: 16px;
  }

  #section-{{ section.id }} .collection__product-title {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #2D4F3E;
    margin: 0 0 8px;
    line-height: 1.4;
  }

  #section-{{ section.id }} .collection__product-price {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #section-{{ section.id }} .collection__current-price {
    font-size: 16px;
    font-weight: 600;
    color: #2D4F3E;
  }

  #section-{{ section.id }} .collection__current-price--sale {
    color: #c0392b;
  }

  #section-{{ section.id }} .collection__compare-price {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
  }

  /* Pagination */
  #section-{{ section.id }} .collection__pagination {
    margin-top: 48px;
    text-align: center;
  }

  #section-{{ section.id }} .collection__pagination-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  #section-{{ section.id }} .collection__page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    font-size: 14px;
    color: #2D4F3E;
    text-decoration: none;
    border: 1px solid #d1cdc7;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  #section-{{ section.id }} .collection__page-link:hover {
    background-color: #2D4F3E;
    color: #FAF8F5;
    border-color: #2D4F3E;
  }

  #section-{{ section.id }} .collection__page-link--current {
    background-color: #2D4F3E;
    color: #FAF8F5;
    border-color: #2D4F3E;
  }

  #section-{{ section.id }} .collection__empty-text {
    text-align: center;
    font-size: 16px;
    color: #888;
    padding: 40px 0;
  }

  /* Mobile - 2 columns */
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .collection__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    #section-{{ section.id }} .collection__title {
      font-size: 28px;
    }

    #section-{{ section.id }} {
      padding: 40px 16px;
    }

    #section-{{ section.id }} .collection__product-info {
      padding: 12px;
    }

    #section-{{ section.id }} .collection__product-title {
      font-size: 13px;
    }

    #section-{{ section.id }} .collection__current-price {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "main-collection-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
