{% comment %}
  TIMECRAFT — Featured Products Grid ("Our Bestsellers")
  Displays real collection products or rich comparative sample timepieces.
  Yahan bestsellers product cards render hotay hain.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Our Bestsellers'
  assign subtitle = section.settings.subtitle | default: section.settings.subheading | default: 'Hand-picked timepieces loved by watch enthusiasts across Pakistan.'
  assign collection = section.settings.collection
  assign products_count = section.settings.products_count | default: section.settings.products_to_show | default: 4
  assign show_view_all = section.settings.show_view_all
-%}

{%- comment -%} Yahan featured products scroll reveal animation ke sath render hoti hain {%- endcomment -%}
<section class="featured-section reveal-on-scroll" id="featured-products-{{ section.id }}" aria-labelledby="featured-heading-{{ section.id }}">
  <div class="featured-inner">

    <!-- Section Header -->
    <div class="featured-header">
      <span class="featured-eyebrow">Raja Bazaar Showroom Selection</span>
      <h2 class="featured-heading" id="featured-heading-{{ section.id }}">{{ heading }}</h2>
      {%- if subtitle != blank -%}
        <p class="featured-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- 4-Column Product Grid -->
    <div class="featured-grid reveal-stagger-parent">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <!-- High-Character Sample Products with Real Specs & Badges -->
        {%- render 'product-card',
          sample_name: 'Royal Sovereign 18K Gold Automatic',
          sample_price: 'Rs. 18,500',
          sample_compare_price: 'Rs. 22,000',
          sample_badge: 'Miyota Automatic • 40mm',
          sample_specs: 'Sapphire Crystal • Havana Alligator Strap',
          sample_index: 1
        -%}

        {%- render 'product-card',
          sample_name: 'Heritage Classic 316L Stainless Steel',
          sample_price: 'Rs. 14,200',
          sample_compare_price: 'Rs. 16,500',
          sample_badge: 'Precision Quartz • 39mm',
          sample_specs: 'Sunburst Navy Dial • Oyster Link Bracelet',
          sample_index: 2
        -%}

        {%- render 'product-card',
          sample_name: 'Vanguard Stealth Chronograph 100M',
          sample_price: 'Rs. 22,000',
          sample_compare_price: 'Rs. 25,500',
          sample_badge: 'Chrono Calibre • 42mm',
          sample_specs: 'Ceramic Bezel • Triple Sub-Dials • 100M',
          sample_index: 3
        -%}

        {%- render 'product-card',
          sample_name: 'Elegance Leather Rose Emerald Dial',
          sample_price: 'Rs. 11,800',
          sample_compare_price: 'Rs. 13,500',
          sample_badge: 'Fluted Bezel • 38mm',
          sample_specs: 'Sunray Emerald Dial • Italian Calfskin',
          sample_index: 4
        -%}
      {%- endif -%}
    </div>

    <!-- View All CTA Link -->
    {%- if show_view_all -%}
      <div class="featured-view-all">
        {%- if collection != blank -%}
          <a href="{{ collection.url }}" class="btn-outline-view-all">
            <span>View All Watches</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- else -%}
          <a href="/collections/all" class="btn-outline-view-all">
            <span>View Full Watch Catalog</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ---------- Featured Products Section Styles ---------- */
  .featured-section {
    background: #FAF8F5;
    padding: 88px 24px;
    border-top: 1px solid #EBE7E0;
  }

  .featured-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .featured-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 52px;
  }

  .featured-eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C5A46D;
    margin-bottom: 8px;
  }

  .featured-heading {
    font-family: 'Playfair Display', serif;
    font-size: 40px;
    font-weight: 700;
    color: #2D4F3E;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .featured-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #6B6B6B;
    line-height: 1.6;
    margin: 0;
  }

  /* 4-Column Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  /* Product Card Styling */
  .product-card {
    background: #FFFFFF;
    border: 1px solid #E8E4DF;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 32px rgba(45, 79, 62, 0.12);
    border-color: #D4AF37;
  }

  .product-card__header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 6px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: none;
  }

  .product-card__badge {
    background: rgba(45, 79, 62, 0.92);
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .product-card__stock-tag {
    background: rgba(197, 164, 109, 0.2);
    color: #8C6D32;
    border: 1px solid rgba(197, 164, 109, 0.4);
    font-family: 'Inter', sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .product-card__media-link {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: #F4F1EC;
  }

  .product-card__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 24px;
    box-sizing: border-box;
  }

  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__img {
    transform: scale(1.06);
  }

  .product-card__vector {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__vector {
    transform: scale(1.05);
  }

  .watch-artwork-svg {
    width: 100%;
    max-width: 170px;
    height: auto;
    max-height: 170px;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.16));
  }

  .product-card__body {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-card__specs-row {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #8C8C8C;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card__title {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 700;
    color: #2D4F3E;
    line-height: 1.35;
    margin: 0 0 10px;
    min-height: 42px;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-card__title a:hover {
    color: #C5A46D;
  }

  .product-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
  }

  .product-card__compare-price {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #9E9E9E;
    text-decoration: line-through;
  }

  .product-card__current-price {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #2D4F3E;
  }

  .product-card__action-wrap {
    margin-top: auto;
  }

  .product-card__btn {
    width: 100%;
    background-color: #2D4F3E;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.15s ease;
    text-align: center;
    text-decoration: none;
    display: block;
    box-sizing: border-box;
  }

  .product-card__btn:hover {
    background-color: #1E3A2B;
    transform: translateY(-1px);
  }

  .product-card__btn:disabled {
    background-color: #C0C0C0;
    cursor: not-allowed;
    transform: none;
  }

  /* View All Button */
  .featured-view-all {
    text-align: center;
    margin-top: 52px;
  }

  .btn-outline-view-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 2px solid #2D4F3E;
    color: #2D4F3E;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 14px 38px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-outline-view-all:hover {
    background-color: #2D4F3E;
    color: #FFFFFF;
  }

  .btn-outline-view-all:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-arrow {
    transition: transform 0.25s ease;
  }

  /* Responsive: Tablet (2 columns) */
  @media (max-width: 991px) {
    .featured-section { padding: 64px 20px; }
    .featured-heading { font-size: 32px; }
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .featured-section { padding: 48px 16px; }
    .featured-heading { font-size: 26px; }
    .featured-header { margin-bottom: 32px; }
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .product-card__body { padding: 14px 12px; }
    .product-card__title { font-size: 14px; min-height: 38px; }
    .product-card__current-price { font-size: 15px; }
    .product-card__btn { padding: 10px 8px; font-size: 11.5px; }
    .product-card__media { padding: 14px; }
  }

  /* Yahan chotay phones par product cards aik column mein comfortable layout mein aate hain */
  @media (max-width: 500px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 420px;
      margin: 0 auto;
    }
    .product-card__title { min-height: auto; font-size: 16px; }
    .product-card__btn { min-height: 44px; padding: 13px; font-size: 13px; }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Bestsellers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Hand-picked timepieces loved by watch enthusiasts across Pakistan."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
