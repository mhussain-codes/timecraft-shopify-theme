{% comment %} TIMECRAFT benefits row - 4 feature highlights with icons {% endcomment %}

{% style %}
  .benefits-section {
    background: #FAF8F5;
    padding: 48px 24px;
    border-top: 1px solid #E8E4DF;
    border-bottom: 1px solid #E8E4DF;
  }

  .benefits-grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .benefit-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 20px;
    position: relative;
  }
  /* Vertical dividers between items */
  .benefit-item + .benefit-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: #DDD8D0;
  }

  .benefit-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    color: #2D4F3E;
  }
  .benefit-icon svg {
    width: 100%;
    height: 100%;
  }

  .benefit-title {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 700;
    color: #2D4F3E;
    margin: 0 0 8px;
    letter-spacing: 0.3px;
  }

  .benefit-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6B6B6B;
    line-height: 1.5;
    margin: 0;
    max-width: 220px;
  }

  /* ---------- Responsive: 2x2 grid on mobile ---------- */
  @media (max-width: 768px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 0;
    }
    /* Hide left borders on first column for mobile */
    .benefit-item:nth-child(odd)::before { display: none; }
    .benefit-item { padding: 20px 12px; }
    /* Top border for bottom row */
    .benefit-item:nth-child(n+3) {
      border-top: 1px solid #DDD8D0;
      padding-top: 24px;
    }
  }

  /* Yahan chotay mobile par benefits cards aik column mein stack hotay hain */
  @media (max-width: 480px) {
    .benefits-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .benefit-item {
      padding: 16px 12px;
      border-top: none !important;
      border-bottom: 1px solid #DDD8D0;
    }
    .benefit-item:last-child {
      border-bottom: none;
    }
  }
{% endstyle %}

{%- comment -%} Yahan benefits row scroll reveal animation ke sath render hoti hai {%- endcomment -%}
<section class="benefits-section reveal-on-scroll" data-section-id="{{ section.id }}">
  <div class="benefits-grid reveal-stagger-parent">
    {%- for block in section.blocks -%}
      {%- liquid
        assign icon_key = block.settings.icon_style | default: block.settings.icon
        if icon_key == 'truck'
          assign icon_key = 'delivery'
        elsif icon_key == 'shield'
          assign icon_key = 'authentic'
        elsif icon_key == 'refresh'
          assign icon_key = 'returns'
        endif
        assign desc = block.settings.description | default: block.settings.text
      -%}
      <div class="benefit-item reveal-stagger-child" {{ block.shopify_attributes }}>

        {%- comment -%} Icon rendered based on icon_style setting {%- endcomment -%}
        <div class="benefit-icon">
          {%- case icon_key -%}

            {%- when 'authentic' -%}
              {%- comment -%} Shield / checkmark icon {%- endcomment -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M24 4L6 12v12c0 11 8 18 18 20 10-2 18-9 18-20V12L24 4z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 24l5 5 11-11"/>
              </svg>

            {%- when 'delivery' -%}
              {%- comment -%} Delivery truck icon {%- endcomment -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
                <rect x="4" y="14" width="26" height="18" rx="2" stroke-linecap="round"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M30 22h8l4 6v4h-12V22z"/>
                <circle cx="14" cy="34" r="3"/>
                <circle cx="37" cy="34" r="3"/>
                <line x1="17" y1="34" x2="34" y2="34"/>
              </svg>

            {%- when 'warranty' -%}
              {%- comment -%} Certificate / ribbon icon {%- endcomment -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
                <circle cx="24" cy="20" r="12"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 30l-2 14 10-5 10 5-2-14"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 18l3 3 6-6"/>
              </svg>

            {%- when 'returns' -%}
              {%- comment -%} Return / refresh arrow icon {%- endcomment -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 24a18 18 0 0132-11"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M42 24a18 18 0 01-32 11"/>
                <polyline points="38,8 38,16 30,16" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="10,40 10,32 18,32" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>

            {%- else -%}
              {%- comment -%} Fallback star icon {%- endcomment -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
                <polygon points="24,4 30,18 44,18 32,28 36,42 24,34 12,42 16,28 4,18 18,18" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>

          {%- endcase -%}
        </div>

        <h3 class="benefit-title">{{ block.settings.title }}</h3>
        <p class="benefit-desc">{{ desc }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Benefits Row",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icon Style",
          "options": [
            { "value": "authentic", "label": "Authentic (Shield)" },
            { "value": "delivery", "label": "Delivery (Truck)" },
            { "value": "warranty", "label": "Warranty (Certificate)" },
            { "value": "returns", "label": "Returns (Refresh)" }
          ],
          "default": "authentic"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of this benefit."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Benefits Row",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_style": "authentic",
            "title": "Authentic Timepieces",
            "description": "Every watch is verified and sourced from trusted brands."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "delivery",
            "title": "Free Delivery in Rawalpindi",
            "description": "Complimentary shipping across Rawalpindi & Islamabad."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "warranty",
            "title": "1 Year Warranty",
            "description": "All watches come with a full one-year warranty."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "returns",
            "title": "Easy Returns",
            "description": "Hassle-free returns within 7 days of purchase."
          }
        }
      ]
    }
  ]
}
{% endschema %}
