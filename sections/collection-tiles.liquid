{% comment %}
  TIMECRAFT — Shop by Category (Collection Tiles)
  Spacious 3-column category cards with rich imagery, clear titles, and responsive wrapping.
  Yahan category cards ka data render hota hai.
{% endcomment %}

{%- comment -%} Yahan category tiles scroll reveal animation ke sath render hoti hain {%- endcomment -%}
<section class="collection-tiles-section reveal-on-scroll" id="section-{{ section.id }}" aria-labelledby="category-heading-{{ section.id }}">
  <div class="category-tiles-container">

    <!-- Section Header -->
    <div class="category-tiles-header">
      <span class="category-tiles-eyebrow">{{ section.settings.eyebrow | default: 'Curated Timepieces' }}</span>
      <h2 class="category-tiles-heading" id="category-heading-{{ section.id }}">{{ section.settings.heading | default: 'Shop by Category' }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="category-tiles-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- Category Grid -->
    <div class="category-tiles-grid reveal-stagger-parent">
      {% for block in section.blocks %}
        {%- liquid
          assign tile_link = block.settings.link
          if tile_link == blank and block.settings.collection != blank
            assign tile_link = block.settings.collection.url
          endif
          if tile_link == blank
            assign tile_link = '/collections/all'
          endif

          assign tile_image = block.settings.image
          if tile_image == blank and block.settings.collection != blank and block.settings.collection.image != blank
            assign tile_image = block.settings.collection.image
          endif

          assign tile_title = block.settings.title
          if tile_title == blank and block.settings.collection != blank
            assign tile_title = block.settings.collection.title
          endif
          if tile_title == blank
            assign tile_title = 'Classic Watches'
          endif

          assign tile_subtitle = block.settings.subtitle
          if tile_subtitle == blank
            case forloop.index
              when 1
                assign tile_subtitle = 'Heritage & Dress Watches'
              when 2
                assign tile_subtitle = 'Precision Steel & Chrono'
              when 3
                assign tile_subtitle = 'Automatic & Gold Accents'
            endcase
          endif
        -%}

        <div class="category-tile reveal-stagger-child" {{ block.shopify_attributes }}>
          <a href="{{ tile_link }}" class="category-tile__link" aria-label="Explore {{ tile_title }}">
            
            <!-- Background & Imagery Wrapper -->
            <div class="category-tile__media">
              {% if tile_image != blank %}
                <div class="watch-photo-container">
                  <img
                    src="{{ tile_image | image_url: width: 900 }}"
                    alt="{{ tile_title | escape }}"
                    loading="lazy"
                    width="900"
                    height="1125"
                    class="category-tile__img"
                  >
                  {% render 'watch-clock-overlay' %}
                </div>
              {% else %}
                <!-- High-character Category Vector Artwork Placeholder (Rawalpindi Live Time) -->
                <div class="category-tile__artwork category-tile__artwork--{{ forloop.index }}">
                  {% case forloop.index %}
                    {% when 1 %}
                      {%- comment -%} Classic Dress Watch: Champagne dial, gold case, brown leather strap {%- endcomment -%}
                      <svg class="category-svg" viewBox="0 0 280 350" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Classic Watches Live Clock" data-live-clock="svg" data-clock-pivot="140 175">
                        <!-- Ambient gradient ring -->
                        <circle cx="140" cy="175" r="120" fill="url(#classic-grad)" opacity="0.15"/>
                        <!-- Leather strap top -->
                        <path d="M105 10 L175 10 L170 85 L110 85 Z" fill="#6B4226" stroke="#52311A" stroke-width="2"/>
                        <line x1="112" y1="20" x2="112" y2="80" stroke="#8B5A36" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <line x1="168" y1="20" x2="168" y2="80" stroke="#8B5A36" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Leather strap bottom -->
                        <path d="M110 265 L170 265 L175 340 L105 340 Z" fill="#6B4226" stroke="#52311A" stroke-width="2"/>
                        <line x1="112" y1="270" x2="112" y2="330" stroke="#8B5A36" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <line x1="168" y1="270" x2="168" y2="330" stroke="#8B5A36" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Gold watch case -->
                        <circle cx="140" cy="175" r="90" fill="#243F32" stroke="#C5A46D" stroke-width="6"/>
                        <circle cx="140" cy="175" r="82" fill="#FAF8F5" stroke="#E0D5C1" stroke-width="2"/>
                        <!-- Inner railway minute track -->
                        <circle cx="140" cy="175" r="74" stroke="#C5A46D" stroke-width="1" stroke-dasharray="2 3" opacity="0.6"/>
                        <!-- Hour markers (Roman & Batons) -->
                        <text x="140" y="118" text-anchor="middle" fill="#2D4F3E" font-family="'Playfair Display', serif" font-size="14" font-weight="700">XII</text>
                        <text x="140" y="246" text-anchor="middle" fill="#2D4F3E" font-family="'Playfair Display', serif" font-size="14" font-weight="700">VI</text>
                        <text x="204" y="180" text-anchor="middle" fill="#2D4F3E" font-family="'Playfair Display', serif" font-size="14" font-weight="700">III</text>
                        <text x="76" y="180" text-anchor="middle" fill="#2D4F3E" font-family="'Playfair Display', serif" font-size="14" font-weight="700">IX</text>
                        <!-- Brand branding on dial -->
                        <text x="140" y="145" text-anchor="middle" fill="#2D4F3E" font-family="'Playfair Display', serif" font-size="10" font-weight="700" letter-spacing="2">TIMECRAFT</text>
                        <text x="140" y="156" text-anchor="middle" fill="#C5A46D" font-family="'Inter', sans-serif" font-size="6" font-weight="600" letter-spacing="1.5">CLASSIC</text>
                        <!-- Live Blued Hands -->
                        <line class="clock-hand clock-hand--hour" x1="140" y1="175" x2="140" y2="128" stroke="#1A334A" stroke-width="3.5" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--minute" x1="140" y1="175" x2="140" y2="110" stroke="#1A334A" stroke-width="2.2" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--second" x1="140" y1="195" x2="140" y2="102" stroke="#C5A46D" stroke-width="1.2" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <circle cx="140" cy="175" r="4" fill="#C5A46D"/>
                        <circle cx="140" cy="175" r="1.5" fill="#1A334A"/>
                        <!-- Crown -->
                        <rect x="230" y="168" width="10" height="14" rx="2" fill="#C5A46D" stroke="#9A7B45" stroke-width="1"/>
                        <defs>
                          <radialGradient id="classic-grad" cx="50%" cy="50%" r="50%">
                            <stop offset="0%" stop-color="#C5A46D"/>
                            <stop offset="100%" stop-color="#2D4F3E" stop-opacity="0"/>
                          </radialGradient>
                        </defs>
                      </svg>

                    {% when 2 %}
                      {%- comment -%} Sports Chronograph: Matte black bezel, steel oyster bracelet, subdials {%- endcomment -%}
                      <svg class="category-svg" viewBox="0 0 280 350" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Sports Watches Live Clock" data-live-clock="svg" data-clock-pivot="140 175">
                        <!-- Steel oyster bracelet top -->
                        <path d="M102 10 L178 10 L172 85 L108 85 Z" fill="#D3D9DE" stroke="#9EABB5" stroke-width="2"/>
                        <line x1="126" y1="10" x2="126" y2="85" stroke="#9EABB5" stroke-width="1.5"/>
                        <line x1="154" y1="10" x2="154" y2="85" stroke="#9EABB5" stroke-width="1.5"/>
                        <!-- Steel bracelet bottom -->
                        <path d="M108 265 L172 265 L178 340 L102 340 Z" fill="#D3D9DE" stroke="#9EABB5" stroke-width="2"/>
                        <line x1="126" y1="265" x2="126" y2="340" stroke="#9EABB5" stroke-width="1.5"/>
                        <line x1="154" y1="265" x2="154" y2="340" stroke="#9EABB5" stroke-width="1.5"/>
                        <!-- Ceramic Tachymeter Bezel -->
                        <circle cx="140" cy="175" r="92" fill="#1A2024" stroke="#48535A" stroke-width="5"/>
                        <circle cx="140" cy="175" r="82" fill="#1E282D" stroke="#C5A46D" stroke-width="1.5"/>
                        <!-- Tachymeter markings -->
                        <text x="140" y="94" text-anchor="middle" fill="#FFFFFF" font-family="'Inter', sans-serif" font-size="7" font-weight="700">TACHYMETRE 400</text>
                        <!-- Chronograph sub-dials -->
                        <circle cx="140" cy="205" r="18" fill="#131B1E" stroke="#48535A" stroke-width="1"/>
                        <circle cx="112" cy="175" r="15" fill="#131B1E" stroke="#48535A" stroke-width="1"/>
                        <circle cx="168" cy="175" r="15" fill="#131B1E" stroke="#48535A" stroke-width="1"/>
                        <!-- Dial Brand -->
                        <text x="140" y="142" text-anchor="middle" fill="#FFFFFF" font-family="'Playfair Display', serif" font-size="10" font-weight="700" letter-spacing="1.5">TIMECRAFT</text>
                        <text x="140" y="152" text-anchor="middle" fill="#C5A46D" font-family="'Inter', sans-serif" font-size="6" font-weight="700" letter-spacing="1">CHRONOGRAPH</text>
                        <!-- Live Luminescent Hands -->
                        <line class="clock-hand clock-hand--hour" x1="140" y1="175" x2="140" y2="128" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--minute" x1="140" y1="175" x2="140" y2="110" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--second" x1="140" y1="195" x2="140" y2="102" stroke="#E65100" stroke-width="1.5" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <circle cx="140" cy="175" r="4.5" fill="#E65100"/>
                        <!-- Chrono Pushers & Crown -->
                        <rect x="231" y="152" width="7" height="9" rx="1.5" fill="#D3D9DE" stroke="#48535A" stroke-width="1"/>
                        <rect x="232" y="169" width="9" height="12" rx="2" fill="#D3D9DE" stroke="#48535A" stroke-width="1"/>
                        <rect x="231" y="189" width="7" height="9" rx="1.5" fill="#D3D9DE" stroke="#48535A" stroke-width="1"/>
                      </svg>

                    {% when 3 %}
                      {%- comment -%} Luxury Collection: Fluted bezel, emerald dial, gold jubilee bracelet {%- endcomment -%}
                      <svg class="category-svg" viewBox="0 0 280 350" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Luxury Watches Live Clock" data-live-clock="svg" data-clock-pivot="140 175">
                        <!-- Two-tone Jubilee bracelet top -->
                        <path d="M104 10 L176 10 L171 85 L109 85 Z" fill="#D3D9DE" stroke="#9EABB5" stroke-width="1.5"/>
                        <rect x="128" y="10" width="24" height="75" fill="#C5A46D" stroke="#A6874B" stroke-width="1"/>
                        <!-- Two-tone Jubilee bracelet bottom -->
                        <path d="M109 265 L171 265 L176 340 L104 340 Z" fill="#D3D9DE" stroke="#9EABB5" stroke-width="1.5"/>
                        <rect x="128" y="265" width="24" height="75" fill="#C5A46D" stroke="#A6874B" stroke-width="1"/>
                        <!-- 18K Fluted Bezel -->
                        <circle cx="140" cy="175" r="92" stroke="#C5A46D" stroke-width="5" stroke-dasharray="4 2" fill="#1C382B"/>
                        <!-- Radiant Sunburst Emerald Dial -->
                        <circle cx="140" cy="175" r="82" fill="#163124" stroke="#C5A46D" stroke-width="1.5"/>
                        <!-- Diamond cut hour batons -->
                        {% for i in (1..12) %}
                          <rect x="138" y="98" width="4" height="12" rx="1" fill="#FFFFFF" stroke="#C5A46D" stroke-width="1" transform="rotate({{ i | times: 30 }} 140 175)"/>
                        {% endfor %}
                        <!-- Date window at 3 o'clock with Cyclops magnifier -->
                        <rect x="195" y="167" width="16" height="16" rx="3" fill="#FFFFFF" stroke="#C5A46D" stroke-width="1.5"/>
                        <text x="203" y="179" text-anchor="middle" fill="#2D4F3E" font-family="'Inter', sans-serif" font-size="9" font-weight="700">21</text>
                        <!-- Luxury Branding -->
                        <text x="140" y="142" text-anchor="middle" fill="#FFFFFF" font-family="'Playfair Display', serif" font-size="11" font-weight="700" letter-spacing="2">TIMECRAFT</text>
                        <text x="140" y="153" text-anchor="middle" fill="#C5A46D" font-family="'Inter', sans-serif" font-size="6" font-weight="600" letter-spacing="1.5">PERPETUAL AUTOMATIC</text>
                        <text x="140" y="215" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-family="'Inter', sans-serif" font-size="6" font-weight="500" letter-spacing="1">SWISS CALIBRE</text>
                        <!-- Live Gold Mercedes-style / Luxury Hands -->
                        <line class="clock-hand clock-hand--hour" x1="140" y1="175" x2="140" y2="128" stroke="#C5A46D" stroke-width="3.5" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--minute" x1="140" y1="175" x2="140" y2="110" stroke="#C5A46D" stroke-width="2.4" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <line class="clock-hand clock-hand--second" x1="140" y1="195" x2="140" y2="102" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" transform="rotate(0 140 175)"/>
                        <circle cx="140" cy="175" r="4.5" fill="#C5A46D"/>
                        <circle cx="140" cy="175" r="2" fill="#1C382B"/>
                        <!-- Gold Crown with Seal -->
                        <rect x="232" y="167" width="9" height="16" rx="2" fill="#C5A46D" stroke="#A6874B" stroke-width="1.2"/>
                      </svg>
                  {% endcase %}
                </div>
              {% endif %}
            </div>

            <!-- Card Bottom Overlay (High Contrast, Never Cropped) -->
            <div class="category-tile__content">
              <span class="category-tile__tag">{{ tile_subtitle }}</span>
              <h3 class="category-tile__title">{{ tile_title }}</h3>
              <div class="category-tile__cta">
                <span>Explore Collection</span>
                <span class="category-tile__arrow" aria-hidden="true">&rarr;</span>
              </div>
            </div>

          </a>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  /* ---------- Shop by Category Section ---------- */
  .collection-tiles-section {
    background-color: #FAF8F5;
    padding: 88px 24px;
    border-top: 1px solid #EBE7E0;
    position: relative;
  }

  .category-tiles-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  .category-tiles-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 52px;
  }

  .category-tiles-eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C5A46D;
    margin-bottom: 8px;
  }

  .category-tiles-heading {
    font-family: 'Playfair Display', serif;
    font-size: 40px;
    font-weight: 700;
    color: #2D4F3E;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .category-tiles-subheading {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #6B6B6B;
    line-height: 1.6;
    margin: 0;
  }

  /* 3 Equal-Width Spacious Cards */
  .category-tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .category-tile {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #1E3A2B;
    box-shadow: 0 4px 20px rgba(45, 79, 62, 0.08);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .category-tile:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(45, 79, 62, 0.18);
  }

  .category-tile__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 440px;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .category-tile__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #183325;
  }

  .category-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-tile:hover .category-tile__img {
    transform: scale(1.06);
  }

  .category-tile__artwork {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    background: linear-gradient(145deg, #1A3627 0%, #11261B 100%);
    transition: transform 0.5s ease;
  }

  .category-tile__artwork--2 {
    background: linear-gradient(145deg, #1B2830 0%, #111B20 100%);
  }

  .category-tile__artwork--3 {
    background: linear-gradient(145deg, #1C382B 0%, #0F231B 100%);
  }

  .category-tile:hover .category-tile__artwork {
    transform: scale(1.04);
  }

  .category-svg {
    width: 100%;
    max-width: 260px;
    height: auto;
    max-height: 310px;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.35));
  }

  /* Scrim overlay: dark gradient at bottom for 100% legibility */
  .category-tile__content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding: 70px 28px 28px;
    background: linear-gradient(to top, rgba(14, 29, 21, 0.95) 0%, rgba(14, 29, 21, 0.75) 55%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .category-tile__tag {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #C5A46D;
    margin-bottom: 6px;
  }

  .category-tile__title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    color: #FAF8F5;
    line-height: 1.25;
    margin: 0 0 14px;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }

  .category-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #FAF8F5;
    border-bottom: 1.5px solid #C5A46D;
    padding-bottom: 4px;
    align-self: flex-start;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .category-tile__arrow {
    transition: transform 0.3s ease;
  }

  .category-tile:hover .category-tile__cta {
    color: #C5A46D;
  }

  .category-tile:hover .category-tile__arrow {
    transform: translateX(4px);
  }

  /* Tablet: 2 or wrapped columns */
  @media (max-width: 991px) {
    .collection-tiles-section { padding: 64px 20px; }
    .category-tiles-heading { font-size: 32px; }
    .category-tiles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .category-tile:nth-child(3) {
      grid-column: span 2;
    }
    .category-tile__link { min-height: 380px; }
  }

  /* Mobile: Clean stacked cards with full touch targets */
  @media (max-width: 640px) {
    .collection-tiles-section { padding: 48px 16px; }
    .category-tiles-header { margin-bottom: 32px; }
    .category-tiles-heading { font-size: 28px; }
    .category-tiles-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .category-tile:nth-child(3) {
      grid-column: auto;
    }
    .category-tile__link { min-height: 340px; }
    .category-tile__content { padding: 50px 20px 20px; }
    .category-tile__title { font-size: 22px; }
  }
</style>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "collection-tiles-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subheading",
      "default": "Curated Timepieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "From heritage mechanical movements to high-performance chronographs, explore our most coveted watch collections."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Classic Watches"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle Tag",
          "default": "Heritage & Dress Watches"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Classic Watches",
            "subtitle": "Heritage & Dress Watches"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Sports & Chrono",
            "subtitle": "Precision Steel & Durability"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Luxury Collection",
            "subtitle": "Automatic & Gold Accents"
          }
        }
      ]
    }
  ]
}
{% endschema %}
