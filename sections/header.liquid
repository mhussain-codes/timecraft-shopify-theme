{% comment %} TIMECRAFT store header - sticky nav with announcement bar {% endcomment %}

{%- liquid
  assign logo_text = section.settings.logo_text
-%}

{% style %}
  /* ---------- Main Header ---------- */
  .header-section {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #FFFFFF;
    border-bottom: 1px solid #E8E4DF;
    transition: box-shadow 0.3s ease;
  }
  .header-section.scrolled {
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .header-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* ---------- Logo ---------- */
  .header-logo a {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #2D4F3E;
  }
  .header-logo svg {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
  .header-logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ---------- Desktop Nav ---------- */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header-nav a {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #2D4F3E;
    text-decoration: none;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    position: relative;
    padding: 4px 0;
    transition: color 0.25s ease;
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #C5A46D;
    transition: width 0.3s ease;
  }
  .header-nav a:hover { color: #C5A46D; }
  .header-nav a:hover::after { width: 100%; }

  /* ---------- Header Actions (Cart + Hamburger) ---------- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header-cart {
    position: relative;
    color: #2D4F3E;
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.25s ease;
  }
  .header-cart:hover { color: #C5A46D; }
  .header-cart svg { width: 24px; height: 24px; }

  .cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #C5A46D;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- Hamburger (mobile only) ---------- */
  .header-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #2D4F3E;
  }
  .header-hamburger svg { width: 26px; height: 26px; }

  /* ---------- Mobile Slide-in Nav ---------- */
  .mobile-nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 2000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-nav-overlay.active { display: block; opacity: 1; }

  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 300px;
    max-width: 85vw;
    height: 100%;
    background: #FFFFFF;
    z-index: 2001;
    transform: translateX(-100%);
    transition: transform 0.35s ease;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav.active { transform: translateX(0); }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #E8E4DF;
  }
  .mobile-nav-header span {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: #2D4F3E;
    letter-spacing: 1.5px;
  }
  .mobile-nav-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #2D4F3E;
    padding: 4px;
  }
  .mobile-nav-close svg { width: 22px; height: 22px; }

  .mobile-nav-links {
    list-style: none;
    margin: 0;
    padding: 16px 0;
    flex: 1;
    overflow-y: auto;
  }
  .mobile-nav-links li { border-bottom: 1px solid #F0ECE6; }
  .mobile-nav-links a {
    display: block;
    padding: 16px 24px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #2D4F3E;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .mobile-nav-links a:hover {
    background: #FAF8F5;
    color: #C5A46D;
  }

  /* ---------- Responsive ---------- */
  /* Yahan tablet aur mobile par header hamburger menu switch hota hai */
  @media (max-width: 1024px) {
    .header-nav { display: none; }
    .header-hamburger { display: flex; }
    .header-inner { height: 64px; }
  }
  @media (max-width: 480px) {
    .header-logo-text { font-size: 18px; letter-spacing: 1px; }
    .header-inner { height: 60px; padding: 0 12px; gap: 6px; }
    .header-clock-emblem { width: 24px; height: 24px; }
    .header-wa-link span { display: none; }
    .header-wa-link { padding: 6px 8px; min-width: 36px; min-height: 36px; justify-content: center; }
  }
  @media (max-width: 340px) {
    .header-logo-text { font-size: 16px; letter-spacing: 0.5px; }
    .header-inner { padding: 0 8px; }
  }
{% endstyle %}

<!-- Main Header -->
<header class="header-section" data-section-id="{{ section.id }}">
  <div class="header-inner">

    <!-- Hamburger Menu - mobile -->
    <button class="header-hamburger" aria-label="Open menu" onclick="document.getElementById('mobile-nav-{{ section.id }}').classList.add('active'); document.getElementById('mobile-overlay-{{ section.id }}').classList.add('active'); document.body.style.overflow='hidden';">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Logo with watch icon (Rawalpindi live analog clock) -->
    <div class="header-logo">
      <a href="/" title="{{ logo_text }}">
        {%- comment -%} Yahan header clock ka SVG render hota hai {%- endcomment -%}
        <svg class="header-clock-emblem" data-header-clock data-live-clock="svg" data-clock-pivot="16 16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" width="28" height="28" aria-label="Rawalpindi Time" role="img">
          <!-- Dial & Bezel -->
          <circle cx="16" cy="16" r="14" stroke="#2D4F3E" stroke-width="2" fill="none"/>
          <circle cx="16" cy="16" r="11.5" stroke="#C5A46D" stroke-width="1" fill="none"/>
          <path d="M30 14.8v2.4h1a0.4 0.4 0 0 0 0.4-0.4v-1.6a0.4 0.4 0 0 0-0.4-0.4h-1z" fill="#2D4F3E"/>
          <!-- Cardinal Hour Marks -->
          <line x1="16" y1="5.6" x2="16" y2="7.4" stroke="#2D4F3E" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="24.6" y1="16" x2="26.4" y2="16" stroke="#2D4F3E" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="16" y1="24.6" x2="16" y2="26.4" stroke="#2D4F3E" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="5.6" y1="16" x2="7.4" y2="16" stroke="#2D4F3E" stroke-width="1.2" stroke-linecap="round"/>
          <!-- Moving Hands: 12 o'clock default, updated dynamically to Asia/Karachi time -->
          <line class="clock-hand clock-hand--hour" x1="16" y1="16" x2="16" y2="9.5" stroke="#2D4F3E" stroke-width="2.2" stroke-linecap="round" transform="rotate(0 16 16)"/>
          <line class="clock-hand clock-hand--minute" x1="16" y1="16" x2="16" y2="6.8" stroke="#2D4F3E" stroke-width="1.6" stroke-linecap="round" transform="rotate(0 16 16)"/>
          <line class="clock-hand clock-hand--second" x1="16" y1="18.5" x2="16" y2="5.5" stroke="#C5A46D" stroke-width="0.9" stroke-linecap="round" transform="rotate(0 16 16)"/>
          <!-- Center Pin Cap -->
          <circle cx="16" cy="16" r="1.6" fill="#C5A46D"/>
          <circle cx="16" cy="16" r="0.75" fill="#2D4F3E"/>
        </svg>
        <span class="header-logo-text">{{ logo_text }}</span>
      </a>
    </div>

    <!-- Desktop Nav Links -->
    <nav>
      <ul class="header-nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Cart Icon -->
    <div class="header-actions">
      <a href="/cart" class="header-cart" aria-label="Cart">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

<!-- Mobile Slide-in Nav -->
<div class="mobile-nav-overlay" id="mobile-overlay-{{ section.id }}" onclick="this.classList.remove('active'); document.getElementById('mobile-nav-{{ section.id }}').classList.remove('active'); document.body.style.overflow='';">
</div>
<nav class="mobile-nav" id="mobile-nav-{{ section.id }}">
  <div class="mobile-nav-header">
    <span>{{ logo_text }}</span>
    <button class="mobile-nav-close" aria-label="Close menu" onclick="this.closest('.mobile-nav').classList.remove('active'); document.getElementById('mobile-overlay-{{ section.id }}').classList.remove('active'); document.body.style.overflow='';">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <ul class="mobile-nav-links">
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_link' -%}
        <li>
          <a href="{{ block.settings.link }}" onclick="document.getElementById('mobile-nav-{{ section.id }}').classList.remove('active'); document.getElementById('mobile-overlay-{{ section.id }}').classList.remove('active'); document.body.style.overflow='';">
            {{ block.settings.label }}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>

<script>
  // Sticky header shadow on scroll
  (function(){
    const header = document.querySelector('.header-section');
    if (!header) return;
    window.addEventListener('scroll', function(){
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "class": "header-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TIMECRAFT"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Home", "link": "/" } },
        { "type": "nav_link", "settings": { "label": "Collections", "link": "/collections" } },
        { "type": "nav_link", "settings": { "label": "About", "link": "/pages/about" } },
        { "type": "nav_link", "settings": { "label": "Contact", "link": "/pages/contact" } },
        { "type": "nav_link", "settings": { "label": "Wholesale", "link": "/pages/wholesale" } }
      ]
    }
  ]
}
{% endschema %}
