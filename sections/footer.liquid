{% comment %} Footer section - 4 columns with store info, links, contact {% endcomment %}

<footer class="site-footer" id="section-{{ section.id }}">
  <div class="footer__container">
    <div class="footer__grid">

      {%- comment %} Column 1 - Logo, description aur social links {% endcomment -%}
      <div class="footer__col footer__col--brand">
        <h3 class="footer__logo">{{ section.settings.logo_text }}</h3>
        <p class="footer__brand-desc">{{ section.settings.brand_description }}</p>
        <div class="footer__social">
          {% if section.settings.social_facebook != blank %}
            <a href="{{ section.settings.social_facebook }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_instagram != blank %}
            <a href="{{ section.settings.social_instagram }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_whatsapp != blank %}
            <a href="{{ section.settings.social_whatsapp }}" class="footer__social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      {%- comment %} Column 2 - Quick links {% endcomment -%}
      <div class="footer__col">
        <h4 class="footer__col-heading">{{ section.settings.col2_heading }}</h4>
        <ul class="footer__links">
          <li><a href="/">Home</a></li>
          <li><a href="/collections">Collections</a></li>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>

      {%- comment %} Column 3 - Customer service links {% endcomment -%}
      <div class="footer__col">
        <h4 class="footer__col-heading">{{ section.settings.col3_heading }}</h4>
        <ul class="footer__links">
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns</a></li>
          <li><a href="/pages/warranty">Warranty</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      {%- comment %} Column 4 - Contact info aur address {% endcomment -%}
      <div class="footer__col">
        <h4 class="footer__col-heading">{{ section.settings.col4_heading }}</h4>
        <ul class="footer__contact-list">
          {% if section.settings.address != blank %}
            <li class="footer__contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{{ section.settings.address }}</span>
            </li>
          {% endif %}
          {% if section.settings.phone != blank %}
            <li class="footer__contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <span>{{ section.settings.phone }}</span>
            </li>
          {% endif %}
          {% if section.settings.email != blank %}
            <li class="footer__contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>{{ section.settings.email }}</span>
            </li>
          {% endif %}
          {% if section.settings.hours != blank %}
            <li class="footer__contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{{ section.settings.hours }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    {%- comment %} Payment methods note {% endcomment -%}
    {% if section.settings.payment_note != blank %}
      <div class="footer__payment-note">
        <p>{{ section.settings.payment_note }}</p>
      </div>
    {% endif %}

    {%- comment %} Copyright bar {% endcomment -%}
    <div class="footer__copyright">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  #section-{{ section.id }} {
    background-color: #2D4F3E;
    color: #FAF8F5;
    padding: 60px 20px 0;
    font-family: 'Inter', sans-serif;
  }

  #section-{{ section.id }} .footer__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  #section-{{ section.id }} .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(250, 248, 245, 0.15);
  }

  /* Brand column */
  #section-{{ section.id }} .footer__logo {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: #C5A46D;
    margin: 0 0 12px;
  }

  #section-{{ section.id }} .footer__brand-desc {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(250, 248, 245, 0.8);
    margin: 0 0 20px;
  }

  #section-{{ section.id }} .footer__social {
    display: flex;
    gap: 12px;
  }

  #section-{{ section.id }} .footer__social-link {
    color: #FAF8F5;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
  }

  #section-{{ section.id }} .footer__social-link:hover {
    color: #C5A46D;
  }

  /* Column headings */
  #section-{{ section.id }} .footer__col-heading {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: #C5A46D;
    margin: 0 0 16px;
    font-weight: 600;
  }

  /* Link lists */
  #section-{{ section.id }} .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #section-{{ section.id }} .footer__links li {
    margin-bottom: 10px;
  }

  #section-{{ section.id }} .footer__links a {
    color: rgba(250, 248, 245, 0.8);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  #section-{{ section.id }} .footer__links a:hover {
    color: #C5A46D;
  }

  /* Contact list */
  #section-{{ section.id }} .footer__contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #section-{{ section.id }} .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 14px;
    color: rgba(250, 248, 245, 0.8);
  }

  #section-{{ section.id }} .footer__contact-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: #C5A46D;
  }

  /* Payment note */
  #section-{{ section.id }} .footer__payment-note {
    text-align: center;
    padding: 20px 0;
    border-bottom: 1px solid rgba(250, 248, 245, 0.15);
  }

  #section-{{ section.id }} .footer__payment-note p {
    font-size: 13px;
    color: rgba(250, 248, 245, 0.6);
    margin: 0;
  }

  /* Copyright bar */
  #section-{{ section.id }} .footer__copyright {
    text-align: center;
    padding: 20px 0;
  }

  #section-{{ section.id }} .footer__copyright p {
    font-size: 13px;
    color: rgba(250, 248, 245, 0.5);
    margin: 0;
  }

  /* Mobile layout - columns stack ho jayein */
  /* Yahan mobile par footer columns aik column mein aate hain */
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    #section-{{ section.id }} {
      padding: 40px 16px 0;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #section-{{ section.id }} .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TIMECRAFT"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Crafting timeless elegance since day one. Premium watches for those who value quality and style."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp URL"
    },
    {
      "type": "header",
      "content": "Quick Links Column"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 Heading",
      "default": "Quick Links"
    },
    {
      "type": "header",
      "content": "Customer Service Column"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 Heading",
      "default": "Customer Service"
    },
    {
      "type": "header",
      "content": "Contact Info Column"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "Column 4 Heading",
      "default": "Contact Info"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Raja Bazaar, Rawalpindi, Pakistan"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+92 300 1234567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@timecraft.pk"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business Hours",
      "default": "Mon - Sat: 10AM - 9PM"
    },
    {
      "type": "header",
      "content": "Payment Note"
    },
    {
      "type": "textarea",
      "id": "payment_note",
      "label": "Payment Methods Note",
      "default": "We accept Cash on Delivery. JazzCash & Easypaisa available upon configuration."
    }
  ]
}
{% endschema %}
