{% comment %}
  Announcement Bar Section
  Store ki top bar - promotions, free delivery notice ya important updates ke liye.
{% endcomment %}

{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="Announcement" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="container announcement-bar__container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          <p class="announcement-bar__text">{{ section.settings.text }}</p>
        </a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.show_close -%}
        <button type="button" class="announcement-bar__close" data-announcement-close aria-label="Close announcement">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    position: relative;
    padding: 9px 16px;
    font-size: 13px;
    letter-spacing: 0.4px;
    font-family: 'Inter', sans-serif;
    text-align: center;
    border-bottom: 1px solid rgba(197, 164, 109, 0.25);
    z-index: 1001;
  }
  .announcement-bar.is-hidden {
    display: none !important;
  }
  .announcement-bar__container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 20px;
  }
  .announcement-bar__text {
    margin: 0;
    font-weight: 500;
  }
  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .announcement-bar__link:hover {
    opacity: 0.9;
    text-decoration: underline;
  }
  .announcement-bar__close {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }
  .announcement-bar__close:hover {
    opacity: 1;
  }
  @media (max-width: 768px) {
    .announcement-bar {
      font-size: 11.5px;
      padding: 7px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free delivery in Rawalpindi & Islamabad on orders above Rs. 5,000 | Cash on Delivery Available"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (Optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2D4F3E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FAF8F5"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show Close Button",
      "default": true
    }
  ]
}
{% endschema %}
