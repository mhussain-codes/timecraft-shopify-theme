<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

  {%- comment -%} Progressive enhancement ke liye no-js ko js se replace karo {%- endcomment -%}
  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  {%- comment -%} SEO title aur description {%- endcomment -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {%- comment -%} Google Fonts - Playfair Display headings ke liye, Inter body text ke liye {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  {%- comment -%} Favicon {%- endcomment -%}
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  {%- comment -%} Canonical URL for SEO {%- endcomment -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Shopify required header content {%- endcomment -%}
  {{ content_for_header }}

  {%- comment -%} Theme stylesheet {%- endcomment -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} CSS variables - brand colors aur typography yahan define hain {%- endcomment -%}
  <style>
    :root {
      /* Brand Colors */
      --color-background: {{ settings.color_background | default: '#FAF8F5' }};
      --color-primary: {{ settings.color_primary | default: '#2D4F3E' }};
      --color-accent: {{ settings.color_accent | default: '#C5A46D' }};
      --color-text: {{ settings.color_text | default: '#1A1A1A' }};
      --color-text-light: {{ settings.color_text_light | default: '#6B6B6B' }};
      --color-border: {{ settings.color_border | default: '#E0DCD7' }};
      --color-white: #FFFFFF;
      --color-overlay: rgba(0, 0, 0, 0.45);

      /* Typography */
      --font-heading: 'Playfair Display', 'Georgia', serif;
      --font-body: 'Inter', 'Helvetica Neue', sans-serif;

      /* Spacing scale */
      --space-xs: 0.5rem;
      --space-sm: 1rem;
      --space-md: 1.5rem;
      --space-lg: 2.5rem;
      --space-xl: 4rem;
      --space-2xl: 6rem;

      /* Layout */
      --container-width: 1280px;
      --header-height: 72px;

      /* Border radius */
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;

      /* Transitions */
      --transition-fast: 150ms ease;
      --transition-base: 250ms ease;
      --transition-slow: 400ms ease;
    }
  </style>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip-to-content" href="#MainContent">
    {{ 'general.accessibility.skip_to_content' | t }}
  </a>

  {%- comment -%} Announcement bar - offers aur updates ke liye {%- endcomment -%}
  {% section 'announcement-bar' %}

  {%- comment -%} Site header with navigation {%- endcomment -%}
  {% section 'header' %}

  {%- comment -%} Main content area - yahan page ka content render hota hai {%- endcomment -%}
  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Site footer {%- endcomment -%}
  {% section 'footer' %}

  {%- comment -%} Theme JavaScript {%- endcomment -%}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
