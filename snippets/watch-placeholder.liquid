{% comment %}
  Watch Placeholder SVG
  Jab product image available nahi ho, tab ye classic watch face dikhata hai.
  Usage: {% render 'watch-placeholder', width: 200, height: 200 %}
{% endcomment %}

{% assign svg_width = width | default: 200 %}
{% assign svg_height = height | default: 200 %}

<svg width="{{ svg_width }}" height="{{ svg_height }}" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Watch placeholder image" class="watch-artwork-svg" data-live-clock="svg" data-clock-pivot="100 100">
  <!-- Watch strap top -->
  <rect x="75" y="10" width="50" height="40" rx="4" fill="#2D4F3E"/>
  <!-- Watch strap bottom -->
  <rect x="75" y="150" width="50" height="40" rx="4" fill="#2D4F3E"/>

  <!-- Watch case outer ring -->
  <circle cx="100" cy="100" r="55" fill="#2D4F3E"/>
  <!-- Watch case inner bezel -->
  <circle cx="100" cy="100" r="50" fill="#C5A46D" opacity="0.3"/>
  <!-- Watch face -->
  <circle cx="100" cy="100" r="46" fill="#FAF8F5"/>

  <!-- Hour tick marks - 12 positions -->
  <!-- 12 o'clock -->
  <rect x="98" y="58" width="4" height="12" rx="2" fill="#2D4F3E"/>
  <!-- 1 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(30 100 100)"/>
  <!-- 2 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(60 100 100)"/>
  <!-- 3 o'clock -->
  <rect x="98" y="58" width="4" height="12" rx="2" fill="#2D4F3E" transform="rotate(90 100 100)"/>
  <!-- 4 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(120 100 100)"/>
  <!-- 5 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(150 100 100)"/>
  <!-- 6 o'clock -->
  <rect x="98" y="58" width="4" height="12" rx="2" fill="#2D4F3E" transform="rotate(180 100 100)"/>
  <!-- 7 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(210 100 100)"/>
  <!-- 8 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(240 100 100)"/>
  <!-- 9 o'clock -->
  <rect x="98" y="58" width="4" height="12" rx="2" fill="#2D4F3E" transform="rotate(270 100 100)"/>
  <!-- 10 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(300 100 100)"/>
  <!-- 11 o'clock -->
  <rect x="98" y="58" width="4" height="8" rx="2" fill="#2D4F3E" transform="rotate(330 100 100)"/>

  <!-- Live Watch Hands (Asia/Karachi Rawalpindi time) -->
  <line class="clock-hand clock-hand--hour" x1="100" y1="100" x2="100" y2="70" stroke="#2D4F3E" stroke-width="3" stroke-linecap="round" transform="rotate(0 100 100)"/>
  <line class="clock-hand clock-hand--minute" x1="100" y1="100" x2="100" y2="58" stroke="#2D4F3E" stroke-width="2" stroke-linecap="round" transform="rotate(0 100 100)"/>
  <line class="clock-hand clock-hand--second" x1="100" y1="112" x2="100" y2="54" stroke="#C5A46D" stroke-width="1.1" stroke-linecap="round" transform="rotate(0 100 100)"/>

  <!-- Center dot -->
  <circle cx="100" cy="100" r="3.5" fill="#C5A46D"/>
  <circle cx="100" cy="100" r="1.5" fill="#2D4F3E"/>

  <!-- Crown (winding knob) -->
  <rect x="152" y="96" width="10" height="8" rx="2" fill="#C5A46D"/>
</svg>
